# ============================================================================
# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o git.
# Gere senhas com: openssl rand -hex 24   (hexadecimal evita caracteres especiais na URL)
# ============================================================================

# --- Somente desenvolvimento local (docker compose) -------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=oleoapp
MONGO_APP_PASSWORD=
MONGO_DB_NAME=oleoapp
REDIS_PASSWORD=

# --- Aplicação (local e Render) ---------------------------------------------
# No Render, MONGO_URL (mongodb+srv do Atlas) e REDIS_URL (URL interna do Key Value)
# são definidos no painel; PORT é definido pelo Render.
# Em produção: ENV=production, COOKIE_SECURE=true, EMAIL_PROVIDER=brevo e FRONTEND_URL
# com https:// (com ENV=production, a API não sobe sem essas três).
# No compose local, MONGO_URL e REDIS_URL são montados a partir das senhas acima.
ENV=development
MONGO_MAX_POOL_SIZE=10
MONGO_TIMEOUT_MS=10000

SESSION_COOKIE_NAME=oleo_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Login social (opcional; veja docs/login-social.md). Vazio desliga o botão do provedor.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Chave do Google Maps Platform (Routes e Geocoding no servidor; Places só no script de candidatos)
GOOGLE_MAPS_API_KEY=
# google ou nominatim (conforme o resultado da tarefa G-03)
GEOCODER=google
NOMINATIM_USER_AGENT="OleoApp/1.0 (contato: suporte@exemplo.com)"
# Sugestões enquanto digita (Photon/OpenStreetMap; também usa o NOMINATIM_USER_AGENT)
PHOTON_URL=https://photon.komoot.io/api/

# Área atendida: centro aproximado de Maricá-RJ e raio em km
AREA_CENTER_LAT=-22.9189
AREA_CENTER_LNG=-42.8186
AREA_RADIUS_KM=40

# E-mail: console (só fora de produção) ou brevo
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=ÓleoApp
PASSWORD_RESET_TTL_MIN=30

# Rate limit
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_PASSWORD_FORGOT_PER_HOUR=5
# Pedidos de redefinição de senha para o mesmo e-mail por hora
RATE_LIMIT_PASSWORD_FORGOT_PER_EMAIL_PER_HOUR=3
RATE_LIMIT_DIRECTIONS_PER_HOUR=30
RATE_LIMIT_GEOCODE_PER_MIN=30
RATE_LIMIT_GEOCODE_SUGGEST_PER_MIN=60
RATE_LIMIT_ADMIN_PER_MIN=60
# Auditoria: eventos mais antigos que isso são apagados pelo Mongo (índice TTL)
AUDIT_LOG_RETENTION_DAYS=90
# Exportação CSV dos logs (máximo de linhas por arquivo)
ADMIN_EXPORT_MAX_ROWS=10000
# Alerta de falhas de login: N falhas do mesmo IP ou e-mail em X minutos
LOGIN_FAILURE_ALERT_THRESHOLD=5
LOGIN_FAILURE_ALERT_WINDOW_MIN=15
# Só para o script do primeiro admin (opcionais; sem elas o script pergunta no terminal)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Proxies confiáveis que acrescentam IPs ao X-Forwarded-For (Render = 1; sem proxy = 0)
TRUSTED_PROXY_HOPS=1

# --- Testes ------------------------------------------------------------------
# Os testes sempre usam ENV=test, ignoram este arquivo no Settings e trocam o REDIS_URL por
# TEST_REDIS_URL (padrão: redis://localhost:6379/15), apagando só esse banco do Redis.
# Para rodar no container (docker compose run --rm api pytest), aponte para o Redis do compose:
# TEST_REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/15
